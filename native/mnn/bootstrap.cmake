# Loaded by the pinned MNN project without changing its Git checkout.
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL LMA_MNN_SOURCE)
  function(lma_add_mnn_worker)
    get_target_property(diffusion_sources diffusion SOURCES)
    list(REMOVE_ITEM diffusion_sources "${LMA_MNN_SOURCE}/transformers/diffusion/engine/src/sana_diffusion.cpp")
    set_property(TARGET diffusion PROPERTY SOURCES "${diffusion_sources};${LMA_MNN_GENERATED}/sana_diffusion.cpp")
    target_include_directories(diffusion PRIVATE "${LMA_MNN_SOURCE}/transformers/diffusion/engine/src")
    add_executable(lma_mnn_worker "${LMA_MNN_INTEGRATION}/worker.cpp")
    target_compile_features(lma_mnn_worker PRIVATE cxx_std_17)
    if(MSVC)
      target_compile_options(lma_mnn_worker PRIVATE /EHsc /bigobj)
      target_include_directories(lma_mnn_worker PRIVATE "${LMA_MNN_HOST_COMPAT}")
    else()
      target_compile_options(lma_mnn_worker PRIVATE -fexceptions)
    endif()
    target_include_directories(lma_mnn_worker PRIVATE "${LMA_MNN_GENERATED}" "${LMA_MNN_INTEGRATION}" "${LMA_JSON_SOURCE}"
      "${LMA_MNN_SOURCE}/transformers/diffusion/engine/include" "${LMA_MNN_SOURCE}/transformers/llm/engine/include")
    target_compile_definitions(lma_mnn_worker PRIVATE LMA_MNN_REVISION="${LMA_MNN_REVISION}")
    target_link_libraries(lma_mnn_worker PRIVATE ${MNN_DEPS})
    if(ANDROID)
      target_link_options(lma_mnn_worker PRIVATE -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384)
      set_target_properties(lma_mnn_worker PROPERTIES OUTPUT_NAME "liblma-mnn" SUFFIX ".so" SKIP_BUILD_RPATH TRUE)
    else()
      set_target_properties(lma_mnn_worker PROPERTIES OUTPUT_NAME "lma_mnn_host")
    endif()
  endfunction()
  cmake_language(DEFER CALL lma_add_mnn_worker)
endif()
