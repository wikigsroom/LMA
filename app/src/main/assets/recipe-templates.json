{
  "schema": "lma.recipe-catalogue/1",
  "templates": [
    {
      "id": "sd15_checkpoint_cpu_v1",
      "name": "SD 1.5 · 完整 checkpoint",
      "primaryRole": "model",
      "definition": {
        "engine": "sd_cpp",
        "backend": "cpu",
        "tasks": [
          "image"
        ],
        "capabilities": [
          "text_to_image"
        ],
        "parameters": {
          "version": 1,
          "fields": {
            "width": {
              "type": "integer",
              "label": "宽度",
              "default": 512,
              "minimum": 64,
              "maximum": 2048,
              "presets": [
                256,
                384,
                512,
                768,
                1024
              ],
              "multipleOf": 64,
              "limitSource": "application_guard"
            },
            "height": {
              "type": "integer",
              "label": "高度",
              "default": 512,
              "minimum": 64,
              "maximum": 2048,
              "presets": [
                256,
                384,
                512,
                768,
                1024
              ],
              "multipleOf": 64,
              "limitSource": "application_guard"
            },
            "steps": {
              "type": "integer",
              "label": "采样步数",
              "default": 20,
              "minimum": 1,
              "maximum": 200,
              "presets": [
                4,
                8,
                12,
                20,
                30
              ],
              "multipleOf": 1,
              "limitSource": "application_guard"
            },
            "threads": {
              "type": "integer",
              "label": "CPU 线程",
              "default": 4,
              "minimum": 1,
              "maximum": 64,
              "presets": [
                1,
                2,
                4,
                6,
                8
              ],
              "multipleOf": 1,
              "limitSource": "application_guard"
            },
            "seed": {
              "type": "integer",
              "label": "随机种子（-1 为随机）",
              "default": -1,
              "minimum": -1,
              "maximum": 2147483647,
              "presets": [
                -1,
                0,
                42
              ],
              "multipleOf": 1,
              "limitSource": "application_guard"
            },
            "cfg": {
              "type": "number",
              "label": "提示词引导",
              "default": 7,
              "minimum": 0,
              "maximum": 30,
              "presets": [
                1,
                3,
                5,
                7,
                9
              ],
              "limitSource": "application_guard"
            },
            "sampler": {
              "type": "enum",
              "label": "采样器",
              "default": "euler",
              "values": [
                "euler",
                "euler_a"
              ]
            },
            "vaeTiling": {
              "type": "boolean",
              "label": "分块解码 VAE",
              "default": true
            }
          }
        },
        "architecture": "sd15",
        "pipeline": "sd15"
      },
      "requirements": [
        {
          "role": "model",
          "label": "完整 checkpoint（含编码器 / VAE）",
          "formats": [
            "gguf",
            "safetensors"
          ],
          "required": true
        }
      ],
      "fixedComponents": [
        {
          "role": "clip_merges",
          "repository": "stable-diffusion-v1-5/stable-diffusion-v1-5",
          "revision": "451f4fe16113bff5a5d2269ed5ad43b0592e9a14",
          "path": "tokenizer/merges.txt",
          "bytes": 524619,
          "sha256": "9fd691f7c8039210e0fced15865466c65820d09b63988b0174bfe25de299051a",
          "format": "text",
          "url": "https://huggingface.co/stable-diffusion-v1-5/stable-diffusion-v1-5/resolve/451f4fe16113bff5a5d2269ed5ad43b0592e9a14/tokenizer/merges.txt"
        }
      ],
      "help": "只适用于完整 checkpoint。独立 diffusion 权重需要另一套完整组件配方；张量架构、量化兼容与资源尚需验证。"
    },
