{
  "schema": "lma.workflow.proposal/0.2",
  "id": "local-narrated-image",
  "title": {
    "zh": "本地图片与旁白合成静态短片",
    "en": "Local narrated still-image clip"
  },
  "status": "design_only_not_executable",
  "reviewed_on": "2026-10-27",
  "implemented_in_lma": false,
  "tested_on_z20": false,
  "output_semantics": "still_image_with_narration_not_generative_motion_video",
  "bindings": {
    "text_model": {
      "kind": "local_model_bundle",
      "resolved": false,
      "required_task": "text.generate"
    },
    "tts_model": {
      "kind": "local_model_bundle",
      "resolved": false,
      "required_task": "speech.synthesize",
      "family_example": "MOSS-TTS-Nano-100M-or-matching-small-TTS"
    },
    "image_model": {
      "kind": "local_model_bundle",
      "resolved": false,
      "required_task": "image.generate",
      "family_example": "Stable-Diffusion-1.5-with-matching-components"
    }
  },
  "policy": {
    "execution_device": "same_android_phone_for_all_stages",
    "inference_network": "loopback_only",
    "asset_network": "explicit_downloads_before_execution_only",
    "external_inference_providers": "forbidden",
    "off_device_fallback": "forbidden",
    "local_large_engine_concurrency": 1,
    "engine_transition": "unload_before_next_large_engine",
    "missing_assets": "wait_for_user_download_then_revalidate",
    "unsupported_device_or_node": "fail_locally_with_reason",
    "uncheckpointed_resume": "restart_node_and_record_retry",
    "settings": "snapshot_and_validate_against_pinned_model_provider_and_device",
    "artifacts": "validated_local_artifact_ids_only"
  },
  "nodes": [
    {
      "id": "input",
      "type": "core.text_input",
      "execution": "local",
      "inputs": {},
      "outputs": {
        "text": "Text"
      },
      "parameters": {
        "text": "为桌面台灯写一段简短的画面描述与中文旁白。"
      }
    },
    {
      "id": "script",
      "type": "text.compose_media_script",
      "execution": "local",
      "binding": "text_model",
      "inputs": {
        "text": "Text"
      },
      "outputs": {
        "visual_prompt": "Text",
        "narration": "Text"
      },
      "parameters": {
        "structured_output": "validate_visual_prompt_and_narration_fields",
        "invalid_output": "fail_with_parse_error"
      }
    },
    {
      "id": "image",
      "type": "image.generate",
      "execution": "local",
      "binding": "image_model",
      "inputs": {
        "prompt": "Text"
      },
      "outputs": {
        "image": "ImageArtifact"
      },
      "parameters": {
        "width": 512,
        "height": 512,
        "batch": 1,
        "sampler": "bound_recipe_default",
        "steps": "bound_recipe_default",
        "seed": 12345
      }
    },
    {
      "id": "narration",
      "type": "speech.synthesize",
      "execution": "local",
      "binding": "tts_model",
      "inputs": {
        "text": "Text"
      },
      "outputs": {
        "audio": "AudioArtifact"
      },
      "parameters": {
        "language": "zh",
        "voice": "bound_model_default",
        "chunk_queue": "bounded"
      }
    },
    {
      "id": "compose",
      "type": "media.encode_narrated_still_clip",
      "execution": "local",
      "inputs": {
        "image": "ImageArtifact",
        "audio": "AudioArtifact"
      },
      "outputs": {
        "video": "VideoArtifact"
      },
      "parameters": {
        "duration_policy": "match_narration",
        "motion_generation": false,
        "codec_policy": "probe_device_and_encode_or_fail_explicitly"
      }
    },
    {
      "id": "save",
      "type": "core.save_artifact",
      "execution": "local",
      "inputs": {
        "artifact": "VideoArtifact"
      },
      "outputs": {
        "artifact": "VideoArtifact"
      },
      "parameters": {
        "destination": "app_private_artifact_store"
      }
    }
  ],
  "edges": [
    {
      "from": [
        "input",
        "text"
      ],
      "to": [
        "script",
        "text"
      ]
    },
    {
      "from": [
        "script",
        "visual_prompt"
      ],
      "to": [
        "image",
        "prompt"
      ]
    },
    {
      "from": [
        "script",
        "narration"
      ],
      "to": [
        "narration",
        "text"
      ]
    },
    {
      "from": [
        "image",
        "image"
      ],
      "to": [
        "compose",
        "image"
      ]
    },
    {
      "from": [
        "narration",
        "audio"
      ],
      "to": [
        "compose",
        "audio"
      ]
    },
    {
      "from": [
        "compose",
        "video"
      ],
      "to": [
        "save",
        "artifact"
      ]
    }
  ],
  "outputs": {
    "result": {
      "node": "save",
      "port": "artifact",
      "type": "VideoArtifact"
    }
  },
  "current_release_requirement": false,
  "scope_note": {
    "zh": "历史不可执行设计；现行需求为平级模型、任务表单、队列与结果，不建设节点编辑或 ComfyUI 导入。",
    "en": "Historical non-executable design; current scope uses flat models, task forms, queue and artifacts, without node editing or ComfyUI import."
  },
  "superseded_by": "multimodal-release-scope.json"
}
