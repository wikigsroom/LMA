# Evidence uses SHA256 of exact input bytes. Never rewrite line endings on checkout.
* -text
* whitespace=cr-at-eol
# Preserve upstream license bytes, including their original whitespace.
app/src/main/assets/licenses/* -whitespace
third_party/notices/* -whitespace
# Retain the exact helper bytes used by recorded host runs; allow its final blank line.
tools/openmoss_host_capture.py whitespace=cr-at-eol,-blank-at-eof
# Preserve original diagnostic stderr bytes, including upstream trailing spaces.
verification/research/openmoss-prompt-issue/native.stderr.txt -whitespace
verification/research/openmoss-scratch-candidate/original-capture-helper.py.txt -whitespace
*.png binary
*.gif binary
*.mp4 binary
*.webm binary
*.so binary
*.apk binary
*.zip binary

# Retain publisher header padding as part of the pinned raw-byte identity.
third_party/ltx098-official/*.header.json whitespace=cr-at-eol,-blank-at-eol
